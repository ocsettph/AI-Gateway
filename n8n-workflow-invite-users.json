            {
              "name": "html",
              "value": "=<!DOCTYPE html>\n<html lang=\"th\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>UBU AI Automation Invitation</title>\n\n  <!-- Google Font: Kanit -->\n  <link href=\"https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n</head>\n\n<body style=\"\n  margin:0;\n  padding:0;\n  background-color:#ffffff;\n  font-family:'Kanit', -apple-system, BlinkMacSystemFont, 'Segoe UI',\n               Tahoma, 'Noto Sans Thai', Arial, sans-serif;\n\">\n\n  <div style=\"max-width:600px; margin:0 auto; padding:24px;\">\n\n    <!-- Logo -->\n    <div style=\"text-align:center; margin:32px 0;\">\n      <img src=\"https://drive.google.com/uc?export=view&id=12XbQzF8M9amxsDvfKUiVRzvse-6BkY1l\"\n           alt=\"UBU AI Logo\"\n           style=\"max-width:200px;\">\n    </div>\n\n    <!-- Card -->\n    <div style=\"background-color:#F9FAFB; border-radius:16px; padding:32px;\">\n\n      <p style=\"font-size:18px; font-weight:600; margin:0 0 16px;\">\n        สวัสดี\n      </p>\n\n      <p style=\"font-size:15px; line-height:26px; margin:0 0 16px;\">\n        คุณได้รับเชิญให้เข้าใช้งาน\n        <strong>n8n Workflow Automation</strong><br>\n        ภายใต้ระบบ <strong>UBU AI Automation</strong><br>\n        ของมหาวิทยาลัยอุบลราชธานี\n      </p>\n\n      <p style=\"font-size:14px; line-height:26px; margin:0 0 20px;\">\n        n8n เป็นแพลตฟอร์มสำหรับสร้างระบบอัตโนมัติ (Workflow Automation)\n        ช่วยเชื่อมต่อการทำงานระหว่างระบบต่าง ๆ เช่น\n        API Gateway, Database และ Email\n      </p>\n\n      <!-- Button -->\n      <div style=\"text-align:center; margin:28px 0;\">\n        <a href=\"{{ $json.inviteLink || 'https://n8n.ubu.ac.th' }}\"\n           target=\"_blank\"\n           style=\"\n             display:inline-block;\n             padding:14px 32px;\n             background-color:#E94E77;\n             color:#ffffff;\n             text-decoration:none;\n             border-radius:999px;\n             font-size:15px;\n             font-weight:600;\n           \">\n          เข้าร่วมใช้งาน UBU AI Automation\n        </a>\n      </div>\n\n      <!-- Info -->\n      <p style=\"font-size:14px; margin:0 0 6px;\">\n        <strong>อีเมล:</strong> ubuaiapi@ubu.ac.th\n      </p>\n      <p style=\"font-size:14px; margin:0 0 20px;\">\n        <strong>URL:</strong> https://n8n.ubu.ac.th\n      </p>\n\n      <p style=\"font-size:14px; line-height:24px; margin:0 0 20px;\">\n        เมื่อคลิกลิงก์ ระบบจะให้คุณตั้งรหัสผ่านและสร้างบัญชีผู้ใช้ด้วยตนเอง\n      </p>\n\n      <p style=\"font-size:14px; margin:0;\">\n        ขอบคุณครับ<br>\n        <strong>UBU AI Team</strong>\n      </p>\n\n    </div>\n\n    <!-- Footer -->\n    <div style=\"text-align:center; margin-top:24px; font-size:12px; color:#98A2B3;\">\n      © 2026 UBU AI Automation. All rights reserved.\n    </div>\n\n  </div>\n</body>\n</html>"
